<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.6"/>

  <!-- Main window -->
  <object class="GtkApplicationWindow" id="main_window">
    <property name="title">mdview</property>
    <property name="default-width">800</property>
    <property name="default-height">1250</property>
    <child>
      <object class="GtkBox" id="content_box">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkStack" id="main_stack">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <!-- Empty state page -->
            <child>
              <object class="GtkBox" id="empty_state_box">
                <property name="name">empty</property>
                <property name="orientation">vertical</property>
                <property name="valign">center</property>
                <property name="halign">center</property>
                <property name="spacing">12</property>
                <property name="css-classes">empty-state</property>
                <child>
                  <object class="GtkLabel" id="empty_state_label">
                    <property name="label">No file opened</property>
                    <property name="css-classes">empty-state-label</property>
                    <property name="wrap">true</property>
                    <property name="max-width-chars">40</property>
                    <property name="halign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="button_box">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <property name="halign">center</property>
                    <child>
                      <object class="GtkButton" id="empty_state_button">
                        <property name="label">Open</property>
                        <property name="css-classes">suggested-action</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="shortcut_label">
                        <property name="label">Ctrl+O</property>
                        <property name="css-classes">shortcut-label</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <!-- Content page -->
            <child>
              <object class="GtkBox" id="scrolled_window_placeholder">
                <property name="orientation">vertical</property>
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSearchBar" id="search_bar">
            <property name="show-close-button">true</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
